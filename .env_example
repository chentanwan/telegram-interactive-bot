# HermesDesk 基本配置
APP_NAME=HermesDesk
BOT_TOKEN=7126xxxxxxxxxxxxxxxxxxxf4He_BbQ

# 客户首次 /start 时看到的欢迎语
WELCOME_MESSAGE="你好，我是 HermesDesk 客服助手。\n请直接发送消息，我会转给人工客服。"

# 各类内置 ID 可以通过 @userinfobot 或类似工具获取
# 后台必须是开启「话题 / Topics」的超级群，并把机器人设为管理员（消息管理 + 话题管理）
ADMIN_GROUP_ID=-1002234110823
ADMIN_USER_IDS=1281631753,1022318030

# 删除话题时是否永久封禁（无法再自动开新话题） TRUE 开启
DELETE_TOPIC_AS_FOREVER_BAN=FALSE

# 利用 /clear 清理后台和用户侧的所有消息（不推荐） TRUE 开启
DELETE_USER_MESSAGE_ON_CLEAR_CMD=FALSE

# 是否禁用人机识别 TRUE 禁用
DISABLE_CAPTCHA=FALSE

# 防止客户不停刷消息。单位：秒。0 为不限制
MESSAGE_INTERVAL=5

# 广播间隔，单位：秒。用于降低 Telegram 429
BROADCAST_INTERVAL=0.05

# 媒体组聚合等待秒数
MEDIA_GROUP_DELAY=5

# 可选：日志级别、数据目录、数据库
LOG_LEVEL=INFO
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/hermesdesk.sqlite3
